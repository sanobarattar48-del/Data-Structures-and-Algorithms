# Merge Sort
def mergeSort(arr):
    if len(arr) > 1:
        mid = len(arr) // 2

        left = arr[:mid]
        right = arr[mid:]

        # Sort the two halves
        mergeSort(left)
        mergeSort(right)

        i = 0
        j = 0
        k = 0

        # Merge the two halves
        while i < len(left) and j < len(right):
            if left[i] < right[j]:
                arr[k] = left[i]
                i += 1
            else:
                arr[k] = right[j]
                j += 1
            k += 1

        # Copy remaining elements of left
        while i < len(left):
            arr[k] = left[i]
            i += 1
            k += 1

        # Copy remaining elements of right
        while j < len(right):
            arr[k] = right[j]
            j += 1
            k += 1


# Main Program
orders = []

n = int(input("Enter number of online orders: "))

for i in range(n):
    time = int(input("Enter delivery time (minutes): "))
    orders.append(time)

print("\nOriginal Delivery Times:")
print(orders)

# Apply Merge Sort
mergeSort(orders)

print("\nSorted Delivery Times (Quickest First):")
print(orders)
